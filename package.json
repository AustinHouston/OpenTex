{
  "name": "opentex",
  "productName": "OpenTex",
  "version": "0.3.1",
  "description": "A simple, reliable LaTeX editor that uses your local TeX installation.",
  "main": "./out/main/index.js",
  "author": "Austin Houston",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "build": {
    "appId": "org.opentex.app",
    "productName": "OpenTex",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "OpenTex-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OpenTex-windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "OpenTex-windows-setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "OpenTex-linux.${ext}"
    },
    "dmg": {
      "title": "OpenTex",
      "artifactName": "OpenTex-mac.dmg"
    },
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "templates",
        "to": "templates"
      }
    ],
    "afterSign": "scripts/adhoc-sign.cjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.20.5",
    "codemirror": "^6.0.2",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AustinHouston/OpenTex.git"
  },
  "homepage": "https://austinhouston.github.io/OpenTex/"
}
